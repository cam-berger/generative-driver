{
  "schema": "driver-protocol/1",
  "runtime_schema": "interface-model/3",
  "channel": {
    "type": "tcp"
  },
  "operations": {
    "identify": {
      "steps": [
        {
          "op": "exchange",
          "tx": [
            {
              "text": "ID?\n"
            }
          ],
          "rx": {
            "mode": "until",
            "delimiter_hex": "0a",
            "max_bytes": 128
          },
          "timeout_ms": 2000,
          "capture": "id",
          "expect": {
            "equals_hex": "44454d4f2d34320a"
          }
        }
      ],
      "outputs": {}
    },
    "measure": {
      "steps": [
        {
          "op": "exchange",
          "tx": [
            {
              "text": "T\n"
            }
          ],
          "rx": {
            "mode": "until",
            "delimiter_hex": "0a",
            "max_bytes": 128
          },
          "timeout_ms": 2000,
          "capture": "reply"
        }
      ],
      "outputs": {
        "temperature": {
          "from": "reply",
          "kind": "ascii_number",
          "prefix": "T:"
        }
      }
    }
  }
}
