                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Base"
          },
          "header_offsets": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Header Offsets"
          },
          "resolve": {
