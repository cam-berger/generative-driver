        "properties": {
          "run_dir": {
            "type": "string",
            "description": "Absolute directory for this run's outputs and evidence."
          },
          "model_dir": {
            "title": "Model Dir",
            "type": "string"
          },
          "n": {
            "default": 3,
            "title": "N",
            "type": "integer"
          },
          "bus_url": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "description": "Explicit ftdi:// adapter URL. No default device is selected."
          },
          "operation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
