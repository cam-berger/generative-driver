{
  "schema": "toolchain-tools/1",
  "note": "Installed public tool contracts. All filesystem path arguments are absolute. run_dir selects writable output storage outside the installation. Optional hardware and analysis tools are loaded only when invoked. Agent execution belongs to the configurator.",
  "tools": [
    {
      "name": "interface_describe",
      "description": "Describe validated executable (schema 3-6) operations and transport capabilities. No device access.",
      "inputSchema": {
        "properties": {
          "run_dir": {
            "type": "string",
            "description": "Absolute directory for this run's outputs and evidence."
          },
          "model_dir": {
            "title": "Model Dir",
            "type": "string"
          }
        },
        "required": [
          "run_dir",
          "model_dir"
        ],
        "type": "object",
        "title": "interface_describeArguments"
      }
    },
    {
      "name": "interface_execute",
      "description": "Execute one typed schema 3-6 operation after identity verification. Bindings are explicit host choices.\nOnly read effects by default; write/actuate require grants. Explicit replay is offline evidence.\n",
      "inputSchema": {
        "properties": {
          "run_dir": {
            "type": "string",
            "description": "Absolute directory for this run's outputs and evidence."
          },
          "model_dir": {
            "title": "Model Dir",
            "type": "string"
          },
          "operation": {
            "title": "Operation",
            "type": "string"
          },
          "parameters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Parameters"
          },
          "binding": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Binding"
          },
          "allow_effects": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Allow Effects"
          },
          "replay": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Replay"
          }
        },
        "required": [
          "run_dir",
          "model_dir",
          "operation"
        ],
        "type": "object",
        "title": "interface_executeArguments"
      }
    },
    {
      "name": "usage_record",
      "description": "Record actual provider token counters with explicit delta/cumulative/unavailable semantics.\nRecords are deduplicated. Cached input and reasoning are subsets, never additive token totals.\n",
      "inputSchema": {
        "properties": {
          "run_dir": {
            "type": "string",
            "description": "Absolute directory for this run's outputs and evidence."
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          },
          "usage": {
            "additionalProperties": true,
            "title": "Usage",
            "type": "object"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model"
          },
          "attempt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Attempt"
          },
          "record_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Record Id"
          }
        },
        "required": [
          "run_dir",
          "stage",
          "usage",
          "source"
        ],
        "type": "object",
        "title": "usage_recordArguments"
      }
    },
    {
      "name": "usage_summary",
      "description": "Report measured stage token proportions and coverage, with tool time counted separately.\nUnknown inference remains unavailable/unattributed. Token shares are not FLOPs or dollar costs.\n",
      "inputSchema": {
        "properties": {
          "run_dir": {
            "type": "string",
            "description": "Absolute directory for this run's outputs and evidence."
          }
        },
        "required": [
          "run_dir"
        ],
        "type": "object",
        "title": "usage_summaryArguments"
      }
    },
    {
      "name": "interpret_collect",
      "description": "Collect a model after interpret_run(mode='prepare'): verify the workspace against the host seal and the\nseal against `expected_seal_sha256` (the seal_sha256 prepare returned; without it, the earliest prepare\nevent, refused when none), freeze the outputs into the run, and report validation (executable schemas 3-6,\nor schema-1 register) and a host re-run of qualification beside ok. `seal_kind` is 'instruction' or\n'enforced'; `transcript` (the agent's JSONL, or .jsonl.gz) is audited for access outside the workspace.\nExperimental schema-2 evidence uses firmware_collect.\n",
      "inputSchema": {
        "properties": {
          "run_dir": {
            "type": "string",
            "description": "Absolute directory for this run's outputs and evidence."
          },
          "attempt": {
            "default": 1,
            "title": "Attempt",
            "type": "integer"
          },
          "agent_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Agent Summary"
          },
          "seal_kind": {
            "default": "instruction",
            "title": "Seal Kind",
            "type": "string"
          },
          "transcript": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Transcript"
          },
          "expected_seal_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Expected Seal Sha256"
          }
        },
        "required": [
          "run_dir"
        ],
        "title": "interpret_collectArguments",
        "type": "object"
      }
    },
    {
      "name": "interpret_run",
      "description": "Prepare a neutral workspace for a configurator-owned interpreter stage. Inputs are copied and hashed, generic skills and validators are bundled, and a host seal is returned for interpret_collect. This tool never launches an agent.",
      "inputSchema": {
        "properties": {
          "run_dir": {
            "type": "string",
            "description": "Absolute directory for this run's outputs and evidence."
          },
          "front_end": {
            "title": "Front End",
            "type": "string"
          },
          "inputs": {
            "additionalProperties": true,
            "title": "Inputs",
            "type": "object"
          },
          "wiring": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Wiring"
          },
          "attempt": {
            "default": 1,
            "title": "Attempt",
            "type": "integer"
          },
          "defects": {
            "anyOf": [
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Defects"
          },
          "mode": {
            "type": "string",
            "enum": [
              "prepare"
            ],
            "default": "prepare"
          },
          "workspace_root": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Workspace Root"
          }
        },
        "required": [
          "run_dir",
          "front_end",
          "inputs"
        ],
        "type": "object",
        "title": "interpret_runArguments"
      }
    },
    {
      "name": "bus_prepare",
      "description": "ESP32 shared-bus adapter only. Requires backend='esp32' and explicit controller ports.\nNever use this to prepare an operating serial-command device. No implicit port enumeration.\n",
      "inputSchema": {
        "properties": {
          "run_dir": {
            "type": "string",
            "description": "Absolute directory for this run's outputs and evidence."
          },
          "mode": {
            "default": "park",
            "title": "Mode",
            "type": "string"
          },
          "ports": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ports"
          },
          "backend": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Backend"
          }
        },
        "required": [
          "run_dir"
        ],
        "type": "object",
        "title": "bus_prepareArguments"
      }
    },
    {
      "name": "acquire_classify",
      "description": "Stage 1. Walk the acquisition ladder and return the device class, the description artifact, and the\nlog of every rung tried. A selected `port` requires `flash_backend=\"esp32\"`; a failed port attempt\ncannot fall through to the an unselected FTDI bus. `part_hint` offers a part marking to look up.\n`transports` (e.g. [\"usb\"]) with the operator's `address` (vid:pid) and optional `serial_number` selects\na self-describing device; a miss then ends the walk and no bus is scanned.\n",
      "inputSchema": {
        "properties": {
          "run_dir": {
            "type": "string",
            "description": "Absolute directory for this run's outputs and evidence."
          },
          "bus_url": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "description": "Explicit ftdi:// adapter URL. No default device is selected."
          },
          "port": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Port"
          },
          "part_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Part Hint"
          },
          "allow_register_sweep": {
            "default": false,
            "title": "Allow Register Sweep",
            "type": "boolean"
          },
          "flash_backend": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Flash Backend"
          },
          "transports": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Transports"
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Address"
          },
          "serial_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Serial Number"
          }
        },
        "required": [
          "run_dir"
        ],
        "type": "object",
        "title": "acquire_classifyArguments"
      }
    },
    {
      "name": "acquire_flash",
      "description": "Use the explicitly selected ESP32 acquisition backend; never guess it from a serial port.\nRequires a known compatible controller. This is not a generic printer firmware-dump tool.\n",
      "inputSchema": {
