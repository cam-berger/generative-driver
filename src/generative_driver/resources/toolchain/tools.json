          "image"
        ],
        "title": "image_map_checkArguments",
        "type": "object"
      }
    },
    {
      "name": "model_qualify",
      "description": "Stage 2. Qualify an executable model offline against supplied replies: streams (interface-replies/1)\nunder complete and fragmented delivery with LF and CRLF, USB (interface-replies/2, one hex reply per\nexchange or control step) as whole transfers or fragmented framed replies, then synthetic faults, through the real engine and adapter.\nProves framing and guard robustness against assumed replies only; never opens hardware.\n",
      "inputSchema": {
        "properties": {
          "run_dir": {
