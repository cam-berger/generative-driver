    {
      "name": "acquire_selfdescription",
      "description": "Stage 1, rung 3. Read one explicitly selected USB device's standard descriptors into descriptor.json,\nraw and parsed, with ENDPOINT.md beside it for the interpreter. transport is \"usb\"; address is the\noperator's vid:pid in hex; serial_number picks one of several matches. Only descriptor reads (and the\nvendor read its own BOS advertises) are sent: nothing is claimed or configured, no data is transferred.\n",
      "inputSchema": {
        "properties": {
          "run_dir": {
            "type": "string",
